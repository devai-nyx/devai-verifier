{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyx/schemas/task-descriptor-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "descriptorVersion",
    "repositoryId",
    "fallbackNodeId",
    "dynamicFallbackSelectors",
    "tasks",
    "profiles"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "descriptorVersion": { "type": "string", "minLength": 1 },
    "repositoryId": { "type": "string", "minLength": 1 },
    "fallbackNodeId": { "type": ["string", "null"] },
    "dynamicFallbackSelectors": {
      "type": "array",
      "items": { "$ref": "#/$defs/selector" }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "dependencies",
          "argv",
          "cwd",
          "runner",
          "inputSelectors",
          "toolchainKeys",
          "allowlistedEnv",
          "outputContract"
        ],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "cwd": { "type": "string", "minLength": 1 },
          "runner": { "type": "string", "minLength": 1 },
          "inputSelectors": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/selector" }
          },
          "toolchainKeys": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "allowlistedEnv": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
          },
          "outputContract": { "type": "object" }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profileId", "mode", "requiredNodes"],
        "properties": {
          "profileId": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["affected", "fixed"] },
          "requiredNodes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "eligibleNodes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "mode": { "const": "affected" } } },
            "then": { "required": ["eligibleNodes"] },
            "else": { "not": { "required": ["eligibleNodes"] } }
          }
        ]
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pattern"],
      "properties": {
        "kind": { "enum": ["exact", "prefix", "glob"] },
        "pattern": { "type": "string", "minLength": 1 }
      }
    }
  }
}
