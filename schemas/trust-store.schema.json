{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyx/schemas/trust-store-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "trustedSigners", "revokedSignerIds"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "trustedSigners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signerId", "publicKeyPem"],
        "properties": {
          "signerId": { "type": "string", "minLength": 1 },
          "publicKeyPem": { "type": "string", "minLength": 1 }
        }
      }
    },
    "revokedSignerIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
