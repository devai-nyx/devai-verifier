{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyx/schemas/signed-envelope-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "payloadType", "payload", "signatures"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "payloadType": {
      "const": "application/vnd.devai.candidate-receipt+json;version=1"
    },
    "payload": { "type": "string", "contentEncoding": "base64" },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signerId", "signature"],
        "properties": {
          "signerId": { "type": "string", "minLength": 1 },
          "signature": { "type": "string", "contentEncoding": "base64" }
        }
      }
    }
  }
}
